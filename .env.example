# Copy this file to .env.local and fill in values from Supabase:
# Dashboard → Project Settings → API

NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-or-publishable-key

# Optional canonical app origin for signup/resend email callback URLs.
# If omitted, Server Actions use the incoming request Origin.
# Add this origin + /auth/callback to Supabase Auth Redirect URLs.
# NEXT_PUBLIC_SITE_URL=http://localhost:3000
